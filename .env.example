NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Compose configuration. Only public Supabase information belongs here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public anon key; never a service-role key.
SUPABASE_ANON_KEY=
# Optional overrides. Defaults in Compose are LOCAL DEVELOPMENT ONLY.
# DATABASE_URL=postgresql+psycopg://stay_insight_app:stay_insight_local@db:5432/stay_insight
# CORS_ORIGINS=http://localhost:3000

# Docker host API port; keep container port 8000. Avoid Windows reserved port 8000.
API_PORT=18000

# Command-only private ingestion DB connection; not injected into the API/browser.
# MARKET_DATABASE_URL=<PostgreSQL URL for a member of stay_insight_ingestion>

# Backend-only MOIS lodging API key. Raw or once URL-encoded; never NEXT_PUBLIC.
PUBLIC_ACCOMMODATION_API_KEY=

# Backend visitor job only; never NEXT_PUBLIC. Operational windows, not provider guarantees.
TOURISM_VISITOR_API_KEY=
TOURISM_VISITOR_LOOKBACK_DAYS=60
TOURISM_VISITOR_REFRESH_DAYS=35

# Backend-only approved KorService2 event service key
TOURISM_EVENT_API_KEY=
