# LOCAL DEVELOPMENT DEFAULTS ONLY. Provision the restricted login after migrations.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://stay_insight_app:stay_insight_local@db:5432/stay_insight
CORS_ORIGINS=http://localhost:3000
# HTTPS Supabase project origin. No secret/service-role/signing key is needed.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Required only when running integration tests; creates/drops isolated test databases.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Export/pass only to python -m app.jobs.sync_accommodation_licenses.
# MARKET_DATABASE_URL=<private PostgreSQL URL; stay_insight_ingestion membership required>

# Backend-only MOIS lodging API key. Raw or once URL-encoded; never NEXT_PUBLIC.
PUBLIC_ACCOMMODATION_API_KEY=

# Hosted API only; staging requires an explicit comma-separated UUID allowlist.
# APP_ENV=staging
# DATABASE_URL=postgresql+psycopg://<runtime-login>:<password>@<verified-host>:5432/postgres?sslmode=require
STAGING_ALLOWED_USER_IDS=
# Optional safe revision label. Render also supplies RENDER_GIT_COMMIT.
DEPLOYMENT_VERSION=
# One-time operational commands only; never inject into the API.
# MIGRATION_DATABASE_URL=<private direct/session admin URL>


# Backend visitor job only; never NEXT_PUBLIC. Operational windows, not provider guarantees.
TOURISM_VISITOR_API_KEY=
TOURISM_VISITOR_LOOKBACK_DAYS=60
TOURISM_VISITOR_REFRESH_DAYS=35
