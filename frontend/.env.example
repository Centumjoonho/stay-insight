NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public anon key, only when a publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-side API address; Compose supplies http://backend:8000.
API_INTERNAL_BASE_URL=

# Staging: use exact HTTPS Vercel and Render origins; rebuild after public changes.
# API_INTERNAL_BASE_URL may be left empty to use NEXT_PUBLIC_API_BASE_URL on the server.
# No Docker service names are reachable from Vercel.
